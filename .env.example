# No API keys are required for the public-data research scan.
# Paper Trading NEW entries require a free OpenRouter LLM key; see README.
# Create a free key at https://openrouter.ai/keys and store it server-side only.
# OPENROUTER_API_KEY=replace-with-your-free-openrouter-key
# CSR_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Independent second AI supervisor (required for new Demo entries).
# Use a SEPARATE key, a DIFFERENT free model, and an OpenAI-compatible HTTPS endpoint.
# The second reviewer receives the same sanitized market evidence independently.
# Until all four values are configured, the robot blocks NEW entries (existing positions are not changed).
# CSR_SECOND_AI_API_KEY=
# CSR_SECOND_AI_MODEL=your-different-free-model:free
# CSR_SECOND_AI_PROVIDER=provider-name
# CSR_SECOND_AI_API_URL=https://provider.example/v1/chat/completions
# Optional public RPC overrides; never put private keys or wallet secrets here.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ETHEREUM_RPC_URL=https://cloudflare-eth.com
# BASE_RPC_URL=https://mainnet.base.org

# Optional AI headline enrichment; explanatory only, never changes scores or gates.
# Obtain a key from Google AI Studio and keep it server-side.
# GEMINI_API_KEY=replace-with-your-key
# CSR_AI_PROVIDER=gemini
# CSR_GEMINI_MODEL=gemini-2.5-flash

# Optional persistent cloud SQLite storage (Turso); set both on Render.
# TURSO_DATABASE_URL=turso://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=server-side-database-token

# BloFin Demo Futures: read-only credentials only.
# Create this key inside BloFin Demo Trading, with READ permission only.
# Never enable TRADE, TRANSFER or Withdrawal during the read-only acceptance phase.
# BLOFIN_DEMO_API_KEY=
# BLOFIN_DEMO_API_SECRET=
# BLOFIN_DEMO_PASSPHRASE=

# Optional independent order smoke test. Keep all these settings on the Demo service only.
# Trade permission and separate Demo keys are required; never use production API keys.
# BLOFIN_DEMO_TRADE_API_KEY=
# BLOFIN_DEMO_TRADE_API_SECRET=
# BLOFIN_DEMO_TRADE_PASSPHRASE=
# BLOFIN_DEMO_TRADING_ENABLED=true
# BLOFIN_DEMO_SMOKE_TEST_ENABLED=true
# BLOFIN_DASHBOARD_TOKEN=
