# No API keys are required for the public-data research scan.
# Legacy Paper Trading profiles may use a free OpenRouter LLM key; see README.
# Challenge 1 V2 uses one verified Groq reviewer (free tier only):
# GROQ_API_KEY=replace-with-your-free-groq-key
# Create a free key at https://openrouter.ai/keys and store it server-side only.
# OPENROUTER_API_KEY=replace-with-your-free-openrouter-key
# CSR_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional public RPC overrides; never put private keys or wallet secrets here.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ETHEREUM_RPC_URL=https://cloudflare-eth.com
# BASE_RPC_URL=https://mainnet.base.org

# Optional AI headline enrichment; explanatory only, never changes scores or gates.
# Obtain a key from Google AI Studio and keep it server-side.
# GEMINI_API_KEY=replace-with-your-key
# CSR_AI_PROVIDER=gemini
# CSR_GEMINI_MODEL=gemini-2.5-flash

# Required for durable cloud storage; the independent GitHub Actions worker requires BOTH values.
# Turso database URLs use the libsql:// scheme; copy the exact URL and token from Turso.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=server-side-database-token

# BloFin account-level credentials. The same credential triplet can be used
# with either environment; the API host selects Live vs Demo. This project's
# Demo adapters are hard-pinned to the Demo host and never read BLOFIN_BASE_URL.
# Standard unified names:
# BLOFIN_API_KEY=
# BLOFIN_API_SECRET=
# BLOFIN_PASSPHRASE=
#
# Optional legacy aliases for older deployments:
# BLOFIN_DEMO_API_KEY=
# BLOFIN_DEMO_API_SECRET=
# BLOFIN_DEMO_PASSPHRASE=
#
# Optional dedicated Demo Trade override (takes precedence if configured).
# Trade permission is checked independently before any order request.
# Keep Transfer and Withdrawal disabled.
# BLOFIN_DEMO_TRADE_API_KEY=
# BLOFIN_DEMO_TRADE_API_SECRET=
# BLOFIN_DEMO_TRADE_PASSPHRASE=

# Keep both switches false until READ, TRADE, Turso and dashboard token checks pass.
# For the free scheduled worker, set these as GitHub Actions repository Variables only after verification.
# BLOFIN_DEMO_TRADING_ENABLED=false
# BLOFIN_DEMO_AUTOPILOT_ENABLED=false

# Optional worker settings. Interval is clamped by the application to 300..900 seconds.
# Omit INSTRUMENTS to use the strategy's built-in instrument list.
# BLOFIN_DEMO_AUTOPILOT_INTERVAL_SECONDS=300
# BLOFIN_DEMO_AUTOPILOT_INSTRUMENTS=BTC-USDT,ETH-USDT

# Required for authenticated Demo account and execution controls.
# Generate a long random value and keep it only in GitHub Actions Repository Secrets (or a private server environment).
# BLOFIN_DASHBOARD_TOKEN=

# Leave the independent one-off smoke test disabled unless deliberately running it.
# BLOFIN_DEMO_SMOKE_TEST_ENABLED=false
# Optional separate token for the one-off smoke-test endpoint.
# BLOFIN_DEMO_SMOKE_TEST_TOKEN=
