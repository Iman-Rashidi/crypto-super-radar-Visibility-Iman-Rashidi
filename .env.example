# No API keys are required for the public-data research scan.
# Paper Trading NEW entries require a free OpenRouter LLM key; see README.
# Create a free key at https://openrouter.ai/keys and store it server-side only.
# OPENROUTER_API_KEY=replace-with-your-free-openrouter-key
# CSR_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional public RPC overrides; never put private keys or wallet secrets here.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ETHEREUM_RPC_URL=https://cloudflare-eth.com
# BASE_RPC_URL=https://mainnet.base.org

# Optional AI headline enrichment; explanatory only, never changes scores or gates.
# Obtain a key from Google AI Studio and keep it server-side.
# GEMINI_API_KEY=replace-with-your-key
# CSR_AI_PROVIDER=gemini
# CSR_GEMINI_MODEL=gemini-2.5-flash

# Optional persistent cloud SQLite storage (Turso); set both on Render.
# TURSO_DATABASE_URL=turso://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=server-side-database-token
