# No API keys are required for the public-data prototype.
# Optional public RPC overrides; never put private keys or wallet secrets here.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ETHEREUM_RPC_URL=https://cloudflare-eth.com
# BASE_RPC_URL=https://mainnet.base.org

# Optional AI headline enrichment; explanatory only, never changes scores or gates.
# Obtain a key from Google AI Studio and keep it server-side.
# GEMINI_API_KEY=replace-with-your-key
# CSR_AI_PROVIDER=gemini
# CSR_GEMINI_MODEL=gemini-2.5-flash

# Durable PostgreSQL reporting store. Tables are auto-created at application startup.
# Use Render's Internal Database URL for a Render-hosted database.
# DATABASE_URL=postgresql://user:password@host:5432/database
# CSR_REQUIRE_POSTGRES=false

# Notion export. The integration must be invited to all three databases.
# NOTION_API_KEY=secret_xxxxxxxxx
# NOTION_LOGS_DB_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NOTION_TRADES_DB_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NOTION_TOKENS_DB_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NOTION_VERSION=2026-03-11

# Optional persistent cloud SQLite storage for the legacy paper ledger and whale store.
# TURSO_DATABASE_URL=turso://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=server-side-database-token
